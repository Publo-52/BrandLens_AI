# ==============================================================================
# BrandLens AI — Backend API Environment Configuration (.env.example)
# Copy this file to .env and fill in real values before starting the server.
# NEVER commit your .env file or real credentials to version control.
# ==============================================================================

# --- Server & Runtime ---------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development
# Port on which the Express API server listens
PORT=5000
# Allowed frontend origin URL for CORS (e.g., http://localhost:5173 or your deployed URL)
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated list of additional allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable demo: fallback bearer tokens (set to false in production)
ALLOW_DEMO_AUTH=false

# --- Database -----------------------------------------------------------------
# MongoDB connection string (local instance or MongoDB Atlas SRV URI)
MONGODB_URI=mongodb://localhost:27017/brandlens

# --- Authentication & Security ------------------------------------------------
# Strong, random secret string used to sign and verify JWT session tokens
JWT_SECRET=replace_with_a_strong_random_jwt_secret

# --- AI & Document Extraction Service -----------------------------------------
# Base URL of the FastAPI AI & document extraction microservice
AI_SERVICE_URL=http://localhost:8000
# Shared secret API key used to authenticate requests to the AI service
AI_SERVICE_API_KEY=replace_with_ai_service_api_key

# --- Cloudinary Media & Document Storage --------------------------------------
# Option A: Full Cloudinary connection URI (if set, overrides the 3 fields below)
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# Option B: Individual Cloudinary credentials (used when CLOUDINARY_URL is empty)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Firebase Admin SDK (Server-Side Token Verification) ----------------------
# Firebase project ID from your Firebase console
FIREBASE_PROJECT_ID=your_firebase_project_id
# Service account client email from Firebase Project Settings > Service Accounts
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Service account private key (wrap in double quotes and keep literal \n line breaks)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Optional: Path to a local Firebase service account JSON file (never commit the JSON file)
FIREBASE_SERVICE_ACCOUNT_PATH=
