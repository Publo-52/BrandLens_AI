# ==============================================================================
# BrandLens AI — Frontend Environment Configuration (.env.example)
# Copy this file to .env and fill in your values.
# Note: Only variables prefixed with VITE_ are exposed to the Vite client bundle.
# NEVER commit your .env file to version control.
# ==============================================================================

# --- Backend API Endpoints ----------------------------------------------------
# Backend API base URL used during local development (`npm run dev`)
# Optional: defaults to http://<current-hostname>:5000 if left unset
VITE_DEV_API_URL=http://localhost:5000
# Backend API base URL used in production builds (`npm run build`)
VITE_API_BASE_URL=https://your-backend-api.example.com

# --- Firebase Web SDK Configuration -------------------------------------------
# Find these values in Firebase Console > Project Settings > Your Apps (Web)
# Firebase Web API key
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
# Firebase Auth domain (e.g., your-project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# Firebase project ID
VITE_FIREBASE_PROJECT_ID=your-project-id
# Firebase Cloud Storage bucket (e.g., your-project-id.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Firebase Cloud Messaging sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# Firebase Web App ID
VITE_FIREBASE_APP_ID=1:000000000000:web:your_firebase_app_id
# Optional: Google Analytics Measurement ID for Firebase Analytics
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
