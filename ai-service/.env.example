# ==============================================================================
# BrandLens AI — AI & Document Extraction Service (.env.example)
# Copy this file to .env and fill in real values before starting FastAPI.
# NEVER commit your .env file or real API keys to version control.
# ==============================================================================

# --- Server & Runtime ---------------------------------------------------------
# Runtime environment: development | production
ENVIRONMENT=development
# Port on which the FastAPI/Uvicorn server listens
PORT=8000

# --- Database (Optional / Shared Knowledge Store) -----------------------------
# MongoDB connection string (local instance or MongoDB Atlas SRV URI)
MONGODB_URI=mongodb://localhost:27017/brandlens

# --- AI Provider & Model Configuration ----------------------------------------
# Generative AI provider name (e.g., gemini, openai)
AI_PROVIDER=gemini
# API key for the configured AI provider (keep secret)
AI_API_KEY=replace_with_your_ai_provider_api_key
# Primary generative LLM model identifier used for compliance & tone checks
AI_MODEL=gemini-1.5-pro
# Text embedding model identifier used for semantic retrieval against approved facts
EMBEDDING_MODEL=text-embedding-004

# --- Service-to-Service Security (Optional) -----------------------------------
# Shared secret key matching backend AI_SERVICE_API_KEY for internal auth
AI_SERVICE_API_KEY=replace_with_ai_service_api_key
# Comma-separated list of allowed CORS origins for the AI service
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173
